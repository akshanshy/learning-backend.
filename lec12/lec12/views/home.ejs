<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Airbnb Home</title>
  <link href="/output.css" rel="stylesheet">
</head>

<body class="bg-gray-100 min-h-screen flex items-center justify-center">

  <div class="bg-white shadow-2xl rounded-3xl p-8 md:p-10 max-w-3xl w-full">
    
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-3 text-center tracking-tight">
      Here are our registered homes
    </h1>
    <p class="text-gray-500 mb-8 text-center">
      Browse the lovely homes our hosts have shared.
    </p>

    <div class="border-t border-gray-200 pt-6">
      <ul class="grid gap-4 sm:grid-cols-2">
        <% registeredHomes.forEach(home => { %>
          <li class="bg-rose-50 border border-rose-100 shadow-sm hover:shadow-md transition-shadow rounded-2xl px-4 py-3 text-left">
            <span class="block text-lg font-semibold text-gray-800 truncate">
              <%= home.houseName %>
            </span>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="mt-8 flex justify-center">
      <a href="/host/add-home" 
         class="inline-flex items-center justify-center bg-red-500 text-white px-8 py-3 rounded-full text-base md:text-lg font-semibold shadow-md hover:bg-red-600 hover:shadow-lg transition-all">
         Add Your Home
      </a>
    </div>

  </div>

</body>
</html>